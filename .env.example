# Database Connection (PostgreSQL - e.g., Neon / Supabase)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/flashai?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-sample.region.neon.tech/flashai?sslmode=require"

# Groq Cloud API Key (Free tier at https://console.groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Groq Model (optional - defaults to openai/gpt-oss-120b with automated fallback cascade)
# GROQ_MODEL="openai/gpt-oss-120b"

